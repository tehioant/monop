{
  "expo": {
    "name": "Atlas",
    "slug": "atlas",
    "version": "0.0.0",
    "scheme": "atlas",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-localization", { "supportedLocales": ["en", "fr"] }],
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }]
    ]
  }
}
